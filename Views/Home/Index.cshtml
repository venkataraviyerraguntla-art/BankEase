@{
    ViewBag.Title = "BankEase Dashboard";
}

<div class="jumbotron">
    <h1>BankEase</h1>
    <p class="lead">Simple Banking Management System</p>
</div>

<div class="row">

    <div class="col-md-3">
        <h3>Customers</h3>
        <p>Manage bank customers.</p>
        <p>@Html.ActionLink("View Customers", "Index", "Customer", null, new { @class = "btn btn-primary" })</p>
    </div>

    <div class="col-md-3">
        <h3>Accounts</h3>
        <p>Manage customer accounts.</p>
        <p>@Html.ActionLink("View Accounts", "Index", "Account", null, new { @class = "btn btn-primary" })</p>
    </div>

    <div class="col-md-3">
        <h3>Transactions</h3>
        <p>View transaction history.</p>
        <p>@Html.ActionLink("View Transactions", "Index", "BankTransaction", null, new { @class = "btn btn-primary" })</p>
    </div>

    <div class="col-md-3">
        <h3>Deposit / Withdraw</h3>
        <p>Perform banking transactions.</p>
        <p>@Html.ActionLink("Deposit", "Deposit", "BankTransaction", null, new { @class = "btn btn-success" })</p>
        <p>@Html.ActionLink("Withdraw", "Withdraw", "BankTransaction", null, new { @class = "btn btn-danger" })</p>
    </div>

</div>